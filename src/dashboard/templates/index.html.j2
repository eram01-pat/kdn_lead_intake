<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Diamond Line Painting — Tender Monitor</title>
<style>
  :root {
    --high: #16a34a; --high-bg: #dcfce7;
    --medium: #d97706; --medium-bg: #fef3c7;
    --new-badge: #2563eb;
    --closing-soon: #dc2626;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: system-ui, sans-serif; font-size: 14px; color: #111; background: #f9fafb; }
  header { background: #1e3a5f; color: white; padding: 1rem 1.5rem; }
  header h1 { font-size: 1.25rem; }
  header .meta { font-size: 0.8rem; opacity: 0.75; margin-top: 0.25rem; }
  .controls { padding: 1rem 1.5rem; background: white; border-bottom: 1px solid #e5e7eb; display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .controls label { font-size: 0.8rem; color: #6b7280; margin-right: 0.25rem; }
  .controls select { font-size: 0.85rem; padding: 0.3rem 0.5rem; border: 1px solid #d1d5db; border-radius: 4px; }
  .controls .count { margin-left: auto; font-size: 0.8rem; color: #6b7280; }
  main { max-width: 1100px; margin: 1.5rem auto; padding: 0 1rem; }
  h2.section-head { font-size: 1rem; color: #374151; margin: 1.5rem 0 0.75rem; padding-bottom: 0.4rem; border-bottom: 2px solid #e5e7eb; }
  .card { background: white; border: 1px solid #e5e7eb; border-radius: 6px; padding: 1rem; margin-bottom: 0.75rem; }
  .card:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
  .card-header { display: flex; align-items: flex-start; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .card-title { font-weight: 600; font-size: 0.95rem; flex: 1; }
  .card-title a { color: #1e3a5f; text-decoration: none; }
  .card-title a:hover { text-decoration: underline; }
  .badge { font-size: 0.7rem; font-weight: 600; padding: 2px 7px; border-radius: 999px; white-space: nowrap; }
  .badge-high    { background: var(--high-bg);   color: var(--high); }
  .badge-medium  { background: var(--medium-bg); color: var(--medium); }
  .badge-new     { background: #dbeafe; color: var(--new-badge); }
  .badge-closing { background: #fee2e2; color: var(--closing-soon); }
  .meta-row { display: flex; gap: 1.25rem; flex-wrap: wrap; font-size: 0.78rem; color: #6b7280; margin-bottom: 0.5rem; }
  .snippet { font-size: 0.82rem; color: #374151; line-height: 1.5; margin-bottom: 0.5rem; }
  .ai-label { font-size: 0.75rem; color: #6b7280; margin-top: 0.3rem; }
  .ai-label .yes  { color: var(--high);   font-weight: 600; }
  .ai-label .maybe { color: var(--medium); font-weight: 600; }
  .bid-cats { font-size: 0.72rem; color: #9ca3af; margin-top: 0.3rem; }
  .bid-cats span { display: inline-block; background: #f9fafb; border: 1px solid #f3f4f6; border-radius: 3px; padding: 1px 5px; margin: 1px 2px 0 0; }
  .empty { text-align: center; color: #9ca3af; padding: 3rem; }
  footer { text-align: center; padding: 2rem; font-size: 0.75rem; color: #9ca3af; }
</style>
</head>
<body>

<header>
  <h1>Diamond Line Painting — Tender Monitor</h1>
  <div class="meta">Generated {{ generated_at }} &mdash; {{ total_open }} open tenders scanned across {{ source_count }} municipalities</div>
</header>

<div class="controls">
  <div>
    <label>Municipality</label>
    <select id="filter-source" onchange="applyFilters()">
      <option value="">All</option>
      {% for src in sources %}<option value="{{ src }}">{{ src }}</option>{% endfor %}
    </select>
  </div>
  <div>
    <label>Confidence</label>
    <select id="filter-conf" onchange="applyFilters()">
      <option value="">All</option>
      <option value="High">High — AI: Yes</option>
      <option value="Medium">Medium — AI: Maybe</option>
    </select>
  </div>
  <div class="count" id="visible-count"></div>
</div>

<main>

  <h2 class="section-head">Active Opportunities
    <span style="font-weight:400;font-size:0.85rem;color:#6b7280">— reviewed by AI</span>
  </h2>

  {% if tenders %}
    {% for t in tenders %}
    <div class="card" data-source="{{ t.source_name }}" data-conf="{{ t.confidence }}">
      <div class="card-header">
        <div class="card-title">
          <a href="{{ t.detail_url }}" target="_blank" rel="noopener">{{ t.title }}</a>
        </div>
        <span class="badge badge-{{ t.confidence | lower }}">{{ t.confidence }}</span>
        {% if t.is_new %}<span class="badge badge-new">New</span>{% endif %}
        {% if t.closing_soon %}<span class="badge badge-closing">Closes in {{ t.days_until_close }}d</span>{% endif %}
      </div>
      <div class="meta-row">
        <span>&#127961; {{ t.source_name }}</span>
        {% if t.reference_no %}<span>Ref: {{ t.reference_no }}</span>{% endif %}
        {% if t.category %}<span>{{ t.category }}</span>{% endif %}
        {% if t.posted_date %}<span>Posted: {{ t.posted_date }}</span>{% endif %}
        {% if t.closing_date %}<span>Closes: {{ t.closing_date }}</span>{% endif %}
      </div>
      {% if t.snippet %}
      <div class="snippet">{{ t.snippet | safe }}</div>
      {% endif %}
      <div class="ai-label">
        AI assessment: <span class="{{ t.llm_decision }}">{{ t.llm_decision | upper }}</span>
        {% if t.llm_reason %}&mdash; {{ t.llm_reason }}{% endif %}
      </div>
      {% if t.bid_categories %}
      <div class="bid-cats">
        Categories: {% for cat in t.bid_categories %}<span>{{ cat }}</span>{% endfor %}
      </div>
      {% endif %}
    </div>
    {% endfor %}
  {% else %}
    <div class="empty">No matched tenders found in this run.</div>
  {% endif %}

</main>

<footer>
  Diamond Line Painting &mdash; Tender Monitor &mdash; reads publicly available municipal procurement portals &mdash;
  <a href="https://github.com/eram01-pat/dlp_lead_intake" target="_blank">source</a>
</footer>

<script>
function applyFilters() {
  const src  = document.getElementById('filter-source').value;
  const conf = document.getElementById('filter-conf').value;
  let visible = 0;
  document.querySelectorAll('.card').forEach(c => {
    const show = (
      (!src  || c.dataset.source === src) &&
      (!conf || c.dataset.conf   === conf)
    );
    c.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  document.getElementById('visible-count').textContent = visible + ' showing';
}
applyFilters();
</script>
</body>
</html>
